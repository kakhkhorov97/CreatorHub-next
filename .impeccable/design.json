  "narrative": {
    "northStar": "September 25 CreatorHub references",
    "overview": "CreatorHub follows the user-approved September 25 white-and-blue discovery, profile, and inbox references. Near-white pages, white content regions, dark navy text, and blue actions replace the earlier warm coral direction. Thin dividers and generous public-page spacing frame portfolio imagery.\n\nThe homepage combines centered discovery search with Popular projects, a looping introduction video, Recently added projects, category links, creative events, and an About/join section. Profiles give work imagery priority; inquiries join inbox, discussion, and details inside one bordered frame. Workspace editing retains its established functional layout.\n\nAdministration has its own visual scope under `/_admin`. A fixed navy sidebar and white toolbar frame a cool light workspace with compact directories and editing panels. This approved admin world is separate from the September 25 public references. Its rules and prefixed tokens apply only inside the administration shell.",
    "keyCharacteristics": [
      "White and near-white backgrounds with blue actions and selected navigation.",
      "Borderless portfolio cards with rounded images and plain captions.",
      "Pill-shaped discovery search, filters, and skill tags.",
      "One joined conversation frame with pale-blue sent messages.",
      "Administration uses a navy sidebar, cool light workspace and compact white record panels."
    ],
    "rules": [
      {
        "name": "The action color rule",
        "body": "Use blue for primary actions and selected navigation; preserve explicit status colors and the red liked heart.",
        "section": "colors"
      },
      {
        "name": "The flat frame rule",
        "body": "Keep depth in borders, white regions, and state fills; preserve borderless portfolio cards.",
        "section": "elevation"
      },
      {
        "name": "The administration scope rule",
        "body": "Apply admin-prefixed tokens only within the administration shell; retain the public and workspace tokens outside it.",
        "section": "colors"
      },
      {
        "name": "The explicit state rule",
        "body": "Keep publication, access and removal actions separate from saving content, with visible confirmation and disabled state controls while edits are unsaved.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the approved September 25 references as the visual authority.",
      "Do preserve visible keyboard focus, labels, disabled states, and reduced-motion behavior.",
      "Do keep portfolio media tied to backend records and identify fictional demo media.",
      "Do retain the existing architecture and backend-supported actions.",
      "Do apply the dedicated admin palette, compact controls and responsive drawer only to administration.",
      "Do keep admin table scrolling inside its panel and retain visible status text and confirmation controls."
    ],
    "donts": [
      "Don't restore the previous coral palette as the product identity.",
      "Don't add invented service thumbnails or unsupported payment and booking flows.",
      "Don't treat generated demo artwork as real client work.",
      "Don't propagate admin styling into public discovery, profiles, inbox or creator workspace pages."
    ]
  }
}
