NEXT_PUBLIC_API_GRAPHQL_URL=http://localhost:7001/graphql
# Server-only. Copy these to .env.local without NEXT_PUBLIC_ prefixes.
GEMINI_API_KEY=
# Select a generateContent model available to your Gemini account.
GEMINI_MODEL=gemini-3.8-flash
# Per-process daily cap. Use a shared rate-limit store for multi-instance deployments.
CHAT_DAILY_LIMIT=200

# Public Google Web application Client ID. Must match backend GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
